+//! HERDR: a retained, local-only WebView for document editor mods.
+//!
+//! This host does not grant the page file or network access. The owning mod
+//! handles its messages under the same policy as its other retained inputs.
+
+use anyhow::{Context as _, Result, bail};
+use gpui::{
+    App, Bounds, Context, Entity, EventEmitter, InteractiveElement as _, IntoElement as _,
+    ParentElement as _, Pixels, Refineable as _, Styled as _, Window, div,
+};
+use std::{
+    io::Read as _,
+    path::{Path, PathBuf},
+    rc::Rc,
+    sync::Arc,
+};
+
+const MAX_ASSET: u64 = 16 * 1024 * 1024;
+const MAX_MESSAGE: usize = 8 * 1024 * 1024;
+const ORIGIN: &str = "herdr-mod://localhost";
+const NATIVE_FOCUS_MESSAGE: &str = "__herdr_native_document_focus__";
+
+#[derive(serde::Deserialize)]
+pub(crate) struct WebViewOptions {
+    pub asset_root: PathBuf,
+    #[serde(default = "default_entry")]
+    pub entry: String,
+}
+fn default_entry() -> String {
+    "index.html".into()
+}
+
+pub(crate) struct WebViewMessage(pub String);
+
+fn message_channel() -> (
+    async_channel::Sender<String>,
+    async_channel::Receiver<String>,
+) {
+    // Like mod commands, control messages must survive bursts of asset requests.
+    async_channel::unbounded()
+}
+
+pub(crate) struct WebViewState {
+    assets: Arc<cap_std::fs::Dir>,
+    entry: String,
+    allowed_visible: bool,
+    retired: bool,
+    focus_handle: Option<gpui::FocusHandle>,
+    #[cfg(target_os = "macos")]
+    native: Option<Rc<wry::WebView>>,
+    #[cfg(target_os = "macos")]
+    messages: Option<gpui::Task<()>>,
+}
+impl EventEmitter<WebViewMessage> for WebViewState {}
+impl Drop for WebViewState {
+    fn drop(&mut self) {
+        self.retire();
+    }
+}
+impl WebViewState {
+    pub(crate) fn new(options: WebViewOptions, policy: &crate::policy::Policy) -> Result<Self> {
+        // The whole bundle needs its own grant. An allowed entry in a child
+        // directory does not authorize sibling assets in the requested parent.
+        let grant = policy
+            .capabilities()
+            .open(&options.asset_root, crate::capability::Access::Read)?;
+        let (dir, relative) = grant.into_parts();
+        let assets = Arc::new(
+            dir.open_dir(relative)
+                .context("WebView asset_root must be a read-granted directory")?,
+        );
+        read_asset(&assets, &options.entry)?;
+        Ok(Self {
+            assets,
+            entry: options.entry,
+            allowed_visible: true,
+            retired: false,
+            focus_handle: None,
+            #[cfg(target_os = "macos")]
+            native: None,
+            #[cfg(target_os = "macos")]
+            messages: None,
+        })
+    }
+    fn receive_message(&mut self, message: String, window: &mut Window, cx: &mut Context<Self>) {
+        if self.retired {
+            return;
+        }
+        if message == NATIVE_FOCUS_MESSAGE {
+            if self.allowed_visible {
+                if let Some(focus) = &self.focus_handle {
+                    focus.focus(window, cx);
+                }
+            }
+            return;
+        }
+        cx.emit(WebViewMessage(message));
+    }
+    pub(crate) fn is_focused(&self, window: &Window) -> bool {
+        !self.retired && self.allowed_visible
+            && self
+                .focus_handle
+                .as_ref()
+                .is_some_and(|focus| focus.is_focused(window))
+    }
+    pub(crate) fn post_message(&self, message: &str) -> Result<()> {
+        if self.retired {
+            bail!("WebView state has been released");
+        }
+        if message.len() > MAX_MESSAGE {
+            bail!("WebView message exceeds 8 MiB");
+        }
+        #[cfg(target_os = "macos")]
+        {
+            let native = self
+                .native
+                .as_ref()
+                .context("WebView has not been mounted yet")?;
+            let payload = serde_json::to_string(message)?;
+            native.evaluate_script(&format!(
+                "window.dispatchEvent(new MessageEvent('message',{{data:{payload}}}));"
+            ))?;
+            Ok(())
+        }
+        #[cfg(not(target_os = "macos"))]
+        bail!("Local document WebViews are currently supported on macOS only")
+    }
+    pub(crate) fn retire(&mut self) {
+        self.set_visible(false);
+        self.retired = true;
+        self.focus_handle = None;
+        #[cfg(target_os = "macos")]
+        {
+            self.messages.take();
+            self.native.take();
+        }
+    }
+    pub(crate) fn set_visible(&mut self, visible: bool) {
+        if self.retired || (visible && self.allowed_visible) {
+            return;
+        }
+        self.allowed_visible = visible;
+        #[cfg(target_os = "macos")]
+        if let Some(native) = &self.native {
+            if !visible {
+                use wry::WebViewExtMacOS as _;
+                let view = native.webview();
+                let mut responder = view.window().and_then(|window| window.firstResponder());
+                while let Some(current) = responder {
+                    if std::ptr::from_ref(&*current).cast::<()>()
+                        == std::ptr::from_ref(&*view).cast::<()>()
+                    {
+                        let _ = native.focus_parent();
+                        break;
+                    }
+                    // SAFETY: state changes and Drop run on AppKit's UI thread;
+                    // the attached view and its owning window remain alive here.
+                    responder = unsafe { current.nextResponder() };
+                }
+            }
+            let _ = native.set_visible(visible);
+        }
+    }
+    #[cfg(target_os = "macos")]
+    fn attach(&mut self, window: &mut Window, cx: &mut Context<Self>) -> Result<()> {
+        if self.retired {
+            bail!("WebView state has been released");
+        }
+        if self.native.is_some() {
+            return Ok(());
+        }
+        self.focus_handle = Some(cx.focus_handle());
+        let assets = self.assets.clone();
+        let (send, receive) = message_channel();
+        let file_drop = send.clone();
+        let url = format!("{ORIGIN}/{}", self.entry);
+        let native = wry::WebViewBuilder::new()
+            .with_url(&url)
+            .with_visible(false)
+            .with_initialization_script(format!(
+                "Object.defineProperty(window, '__HERDR_DOCUMENT_HOST__', {{value: true}});
+window.addEventListener('pointerdown', event => {{if (event.isTrusted && event.button === 0) window.ipc.postMessage({});}}, true);",
+                serde_json::to_string(NATIVE_FOCUS_MESSAGE)?,
+            ))
+            .with_custom_protocol("herdr-mod".into(), move |_, request| {
+                asset_response(&assets, request.uri().path())
+            })
+            .with_navigation_handler(move |target| {
+                target == url
+                    || target
+                        .strip_prefix(&url)
+                        .is_some_and(|tail| tail.starts_with('#'))
+            })
+            .with_new_window_req_handler(|_, _| wry::NewWindowResponse::Deny)
+            .with_drag_drop_handler(move |event| {
+                use wry::DragDropEvent;
+                let (paths, dropped) = match event {
+                    DragDropEvent::Enter { paths, .. } => (paths, false),
+                    DragDropEvent::Drop { paths, .. } => (paths, true),
+                    _ => return false,
+                };
+                let [path] = paths.as_slice() else {
+                    return false;
+                };
+                let Some(file) = path.to_str() else {
+                    return false;
+                };
+                let markdown = path.extension().and_then(|ext| ext.to_str()).is_some_and(|ext| {
+                    ["md", "markdown", "mdown", "mkd"].iter().any(|item| ext.eq_ignore_ascii_case(item))
+                });
+                if !path.is_absolute() || !markdown || !path.is_file() {
+                    return false;
+                }
+                !dropped || file_drop.try_send(serde_json::json!({"type": "open-drop", "file": file}).to_string()).is_ok()
+            })
+            .with_ipc_handler(move |request| {
+                if request.uri().scheme_str() == Some("herdr-mod")
+                    && request.uri().host() == Some("localhost")
+                    && request.body().len() <= MAX_MESSAGE
+                {
+                    let _ = send.try_send(request.into_body());
+                }
+            })
+            .build_as_child(&*window)?;
+        self.native = Some(Rc::new(native));
+        let window_handle = window.window_handle();
+        self.messages = Some(cx.spawn(async move |state, cx| {
+            while let Ok(message) = receive.recv().await {
+                let result = window_handle.update(cx, |_, window, cx| {
+                    state.update(cx, |state, cx| state.receive_message(message, window, cx))
+                });
+                if result.is_err() {
+                    break;
+                }
+            }
+        }));
+        Ok(())
+    }
+}
+
+fn read_asset(directory: &cap_std::fs::Dir, relative: &str) -> Result<Vec<u8>> {
+    let path = Path::new(relative);
+    if path.is_absolute()
+        || path
+            .components()
+            .any(|c| !matches!(c, std::path::Component::Normal(_)))
+    {
+        bail!("WebView asset path must stay inside asset_root");
+    }
+    // cap-std resolves every component through the retained directory handle,
+    // including symlinks. No path is reopened with ambient authority after validation.
+    let file = directory
+        .open(path)
+        .context("WebView asset is unavailable or outside asset_root")?;
+    let metadata = file.metadata()?;
+    if !metadata.is_file() {
+        bail!("WebView asset must be a file");
+    }
+    if metadata.len() > MAX_ASSET {
+        bail!("WebView asset exceeds 16 MiB");
+    }
+    let mut body = Vec::with_capacity(metadata.len() as usize);
+    file.take(MAX_ASSET + 1).read_to_end(&mut body)?;
+    if body.len() as u64 > MAX_ASSET {
+        bail!("WebView asset exceeds 16 MiB");
+    }
+    Ok(body)
+}
+
+#[cfg(target_os = "macos")]
+fn asset_response(
+    assets: &cap_std::fs::Dir,
+    url_path: &str,
+) -> wry::http::Response<std::borrow::Cow<'static, [u8]>> {
+    use std::borrow::Cow;
+    let path = percent_encoding::percent_decode_str(url_path.trim_start_matches('/')).decode_utf8();
+    let asset = path.ok().and_then(|path| {
+        read_asset(assets, &path)
+            .ok()
+            .map(|body| (path.into_owned(), body))
+    });
+    let Some((relative, body)) = asset else {
+        return wry::http::Response::builder()
+            .status(404)
+            .body(Cow::Borrowed(&b"Asset unavailable"[..]))
+            .unwrap();
+    };
+    let mime = match Path::new(&relative)
+        .extension()
+        .and_then(|ext| ext.to_str())
+        .unwrap_or("")
+    {
+        "html" => "text/html; charset=utf-8",
+        "js" | "mjs" => "text/javascript; charset=utf-8",
+        "css" => "text/css; charset=utf-8",
+        "woff2" => "font/woff2",
+        "woff" => "font/woff",
+        "ttf" => "font/ttf",
+        "otf" => "font/otf",
+        "png" => "image/png",
+        "jpg" | "jpeg" => "image/jpeg",
+        "webp" => "image/webp",
+        "gif" => "image/gif",
+        "avif" => "image/avif",
+        "svg" => "image/svg+xml",
+        _ => "application/octet-stream",
+    };
+    wry::http::Response::builder().header("Content-Type", mime)
+        .header("Content-Security-Policy", "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'")
+        .header("X-Content-Type-Options", "nosniff")
+        .body(Cow::Owned(body)).unwrap()
+}
+
+pub(crate) fn element(
+    state: Entity<WebViewState>,
+    refinement: gpui::StyleRefinement,
+    window: &mut Window,
+    cx: &mut App,
+) -> gpui::AnyElement {
+    #[cfg(target_os = "macos")]
+    if let Err(error) = state.update(cx, |state, cx| state.attach(window, cx)) {
+        tracing::error!("cannot mount local document WebView: {error:#}");
+        return div()
+            .child(format!("Document editor could not open: {error}"))
+            .into_any_element();
+    }
+    #[cfg(not(target_os = "macos"))]
+    let _ = window;
+    let mut frame = div().size_full().min_h_0().min_w_0();
+    frame.style().refine(&refinement);
+    if let Some(focus) = state.read(cx).focus_handle.as_ref() {
+        frame = frame.track_focus(focus);
+    }
+    #[cfg(target_os = "macos")]
+    return frame.child(WebViewElement { state }).into_any_element();
+    #[cfg(not(target_os = "macos"))]
+    return frame
+        .child("Local document editing requires the macOS host extension.")
+        .into_any_element();
+}
+
+#[cfg(target_os = "macos")]
+struct WebViewElement {
+    state: Entity<WebViewState>,
+}
+#[cfg(target_os = "macos")]
+impl gpui::IntoElement for WebViewElement {
+    type Element = Self;
+    fn into_element(self) -> Self {
+        self
+    }
+}
+#[cfg(target_os = "macos")]
+impl gpui::Element for WebViewElement {
+    type RequestLayoutState = ();
+    type PrepaintState = ();
+    fn id(&self) -> Option<gpui::ElementId> {
+        None
+    }
+    fn source_location(&self) -> Option<&'static std::panic::Location<'static>> {
+        None
+    }
+    fn request_layout(
+        &mut self,
+        _: Option<&gpui::GlobalElementId>,
+        _: Option<&gpui::InspectorElementId>,
+        window: &mut Window,
+        cx: &mut App,
+    ) -> (gpui::LayoutId, ()) {
+        (
+            window.request_layout(
+                gpui::Style {
+                    size: gpui::Size::full(),
+                    ..Default::default()
+                },
+                [],
+                cx,
+            ),
+            (),
+        )
+    }
+    fn prepaint(
+        &mut self,
+        _: Option<&gpui::GlobalElementId>,
+        _: Option<&gpui::InspectorElementId>,
+        bounds: Bounds<Pixels>,
+        _: &mut (),
+        window: &mut Window,
+        cx: &mut App,
+    ) {
+        let clip = bounds.intersect(&window.content_mask().bounds);
+        let state = self.state.read(cx);
+        if let Some(native) = &state.native {
+            let visible = !state.retired && state.allowed_visible
+                && clip.size.width > gpui::px(0.)
+                && clip.size.height > gpui::px(0.);
+            if visible {
+                let rect = wry::Rect {
+                    position: wry::dpi::LogicalPosition::new(
+                        f64::from(clip.origin.x),
+                        f64::from(clip.origin.y),
+                    )
+                    .into(),
+                    size: wry::dpi::LogicalSize::new(
+                        f64::from(clip.size.width),
+                        f64::from(clip.size.height),
+                    )
+                    .into(),
+                };
+                if let Err(error) = native.set_bounds(rect) {
+                    tracing::warn!("WebView bounds failed: {error}");
+                    return;
+                }
+                // The GPUI parent excludes this native rectangle from its cursor ownership.
+                use wry::WebViewExtMacOS as _;
+                // SAFETY: prepaint runs on AppKit's UI thread while the owning
+                // GPUI window and this attached native view are both alive.
+                if let Some(parent) = unsafe { native.webview().superview() } {
+                    if let Some(window) = parent.window() {
+                        window.invalidateCursorRectsForView(&parent);
+                    }
+                }
+                let _ = native.zoom(f64::from(f32::from(crate::value::scaled_px(1.))));
+                window.insert_hitbox(clip, gpui::HitboxBehavior::BlockMouse);
+            }
+            let _ = native.set_visible(visible);
+        }
+    }
+    fn paint(
+        &mut self,
+        _: Option<&gpui::GlobalElementId>,
+        _: Option<&gpui::InspectorElementId>,
+        _: Bounds<Pixels>,
+        _: &mut (),
+        _: &mut (),
+        _: &mut Window,
+        _: &mut App,
+    ) {
+    }
+}
