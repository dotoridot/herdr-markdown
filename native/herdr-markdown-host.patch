+}
+
+pub unsafe fn ipc(mut env: JNIEnv, _: JClass, url: JString, body: JString) {
+  match (env.get_string(&url), env.get_string(&body)) {
+    (Ok(url), Ok(body)) => {
+      #[cfg(feature = "tracing")]
+      let _span = tracing::info_span!(parent: None, "wry::ipc::handle").entered();
