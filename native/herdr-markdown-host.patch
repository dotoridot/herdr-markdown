+// HERDR: GPUI cursor rectangles only cover the surface GPUI draws.
+fn cursor_regions(bounds: NSRect, native_children: &[NSRect]) -> Vec<NSRect> {
+    let mut regions = vec![bounds];
+    for child in native_children {
+        let mut remaining = Vec::new();
+        for region in regions {
+            let left = region.origin.x.max(child.origin.x);
+            let bottom = region.origin.y.max(child.origin.y);
+            let right = (region.origin.x + region.size.width).min(child.origin.x + child.size.width);
+            let top = (region.origin.y + region.size.height).min(child.origin.y + child.size.height);
+            if left >= right || bottom >= top { remaining.push(region); continue; }
+            for (x, y, width, height) in [
+                (region.origin.x, region.origin.y, region.size.width, bottom - region.origin.y),
+                (region.origin.x, top, region.size.width, region.origin.y + region.size.height - top),
+                (region.origin.x, bottom, left - region.origin.x, top - bottom),
+                (right, bottom, region.origin.x + region.size.width - right, top - bottom),
+            ] {
+                if width > 0. && height > 0. { remaining.push(NSRect::new(NSPoint::new(x, y), NSSize::new(width, height))); }
+            }
+        }
+        regions = remaining;
+    }
+    regions
+}
