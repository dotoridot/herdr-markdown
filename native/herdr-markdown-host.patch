+    #[test]
+    fn local_webview_bridge_keeps_image_burst_and_save_in_order() {
+        let (send, receive) = message_channel();
+        let mut expected: Vec<String> = (0..128).map(|index| format!("image:{index}")).collect();
+        expected.push("save".into());
+        for message in &expected {
+            let _ = send.try_send(message.clone());
+        }
+        let mut actual = Vec::new();
+        while let Ok(message) = receive.try_recv() {
+            actual.push(message);
+        }
+        assert_eq!(
+            actual, expected,
+            "image requests must not drop a queued save"
+        );
+    }
+    #[test]
+    fn local_webview_rejects_entry_only_read_grant() {
+        let root = test_directory();
+        let allowed = root.join("allowed");
+        std::fs::create_dir(&allowed).unwrap();
+        std::fs::write(allowed.join("index.html"), "local").unwrap();
+        std::fs::write(root.join("private.txt"), "private sibling").unwrap();
+        let policy = crate::policy::Policy::new()
+            .with_capabilities(crate::Capabilities::new().read_roots([allowed]));
+        let state = WebViewState::new(
+            WebViewOptions {
+                asset_root: root.clone(),
+                entry: "allowed/index.html".into(),
+            },
+            &policy,
+        );
+        assert!(
+            state.is_err(),
