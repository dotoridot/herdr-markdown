+    pub fn webkit_cookie_manager_get_all_cookies_finish(
+      cookie_manager: *mut WebKitCookieManager,
+      result: *mut gio::ffi::GAsyncResult,
+      error: *mut *mut glib::ffi::GError,
+    ) -> *mut glib::ffi::GList;
+  }
