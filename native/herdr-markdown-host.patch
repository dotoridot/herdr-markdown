+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn test_directory() -> PathBuf {
+        let path = std::env::temp_dir().join(format!(
+            "herdr-webview-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap()
+                .as_nanos()
+        ));
+        std::fs::create_dir_all(&path).unwrap();
+        path.canonicalize().unwrap()
+    }
+    #[test]
+    fn local_assets_reject_parent_and_absolute_paths() {
+        let root = test_directory();
+        std::fs::write(root.as_path().join("index.html"), "local").unwrap();
+        let assets =
+            cap_std::fs::Dir::open_ambient_dir(&root, cap_std::ambient_authority()).unwrap();
+        assert_eq!(read_asset(&assets, "index.html").unwrap(), b"local");
+        for path in ["../outside", "/etc/passwd", "nested/../index.html", ""] {
+            assert!(read_asset(&assets, path).is_err(), "{path}");
+        }
+    }
+    #[test]
+    fn local_webview_bridge_keeps_image_burst_and_save_in_order() {
+        let (send, receive) = message_channel();
+        let mut expected: Vec<String> = (0..128).map(|index| format!("image:{index}")).collect();
+        expected.push("save".into());
+        for message in &expected {
+            let _ = send.try_send(message.clone());
+        }
+        let mut actual = Vec::new();
+        while let Ok(message) = receive.try_recv() {
+            actual.push(message);
+        }
+        assert_eq!(
+            actual, expected,
+            "image requests must not drop a queued save"
+        );
+    }
+    #[test]
+    fn local_webview_rejects_entry_only_read_grant() {
+        let root = test_directory();
+        let allowed = root.join("allowed");
+        std::fs::create_dir(&allowed).unwrap();
+        std::fs::write(allowed.join("index.html"), "local").unwrap();
+        std::fs::write(root.join("private.txt"), "private sibling").unwrap();
+        let policy = crate::policy::Policy::new()
+            .with_capabilities(crate::Capabilities::new().read_roots([allowed]));
+        let state = WebViewState::new(
+            WebViewOptions {
+                asset_root: root.clone(),
+                entry: "allowed/index.html".into(),
+            },
+            &policy,
+        );
+        assert!(
+            state.is_err(),
+            "an allowed entry must not grant its parent asset directory"
+        );
+        std::fs::remove_dir_all(root).unwrap();
+    }
+    #[test]
+    fn local_webview_granted_bundle_serves_html_script_and_fonts() {
+        let root = test_directory();
+        let assets = root.join("allowed");
+        std::fs::create_dir(&assets).unwrap();
+        for (name, bytes) in [
+            ("index.html", "html"),
+            ("editor.js", "script"),
+            ("font.woff2", "font"),
+        ] {
+            std::fs::write(assets.join(name), bytes).unwrap();
+        }
+        std::fs::write(root.join("private.txt"), "private sibling").unwrap();
+        let policy = crate::policy::Policy::new()
+            .with_capabilities(crate::Capabilities::new().read_roots([assets.clone()]));
+        let state = WebViewState::new(
+            WebViewOptions {
+                asset_root: assets.clone(),
+                entry: "index.html".into(),
+            },
+            &policy,
+        )
+        .unwrap();
+        for (name, bytes) in [
+            ("index.html", "html"),
+            ("editor.js", "script"),
+            ("font.woff2", "font"),
+        ] {
+            assert_eq!(read_asset(&state.assets, name).unwrap(), bytes.as_bytes());
+        }
+        assert!(read_asset(&state.assets, "../private.txt").is_err());
+        #[cfg(target_os = "macos")]
+        {
+            let script = asset_response(&state.assets, "/editor.js");
+            assert_eq!(script.status(), 200);
+            assert_eq!(
+                script.headers()["Content-Type"],
+                "text/javascript; charset=utf-8"
+            );
+            assert_eq!(script.body().as_ref(), b"script");
+            let font = asset_response(&state.assets, "/font.woff2");
+            assert_eq!(font.status(), 200);
+            assert_eq!(font.headers()["Content-Type"], "font/woff2");
+            let sibling = asset_response(&state.assets, "/../private.txt");
+            assert_eq!(sibling.status(), 404);
+            assert_ne!(sibling.body().as_ref(), b"private sibling");
+        }
+        std::fs::remove_dir_all(root).unwrap();
+    }
+    #[cfg(unix)]
+    #[test]
+    fn local_assets_reject_symlinks_outside_the_bundle() {
+        let root = test_directory();
+        let outside = root.join("outside");
+        std::fs::write(&outside, "outside").unwrap();
+        let inner = root.join("inner");
+        std::fs::create_dir(&inner).unwrap();
+        std::os::unix::fs::symlink(&outside, inner.join("link")).unwrap();
+        let assets =
+            cap_std::fs::Dir::open_ambient_dir(&inner, cap_std::ambient_authority()).unwrap();
+        assert!(read_asset(&assets, "link").is_err());
+    }
+}
