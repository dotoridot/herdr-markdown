+  pub async fn build_as_child_async<W: HasWindowHandle>(self, window: &'a W) -> Result<WebView> {
+    self.error?;
+
+    InnerWebView::new_as_child_async(window, self.attrs, self.platform_specific)
+      .await
+      .map(|webview| WebView { webview })
+  }
+}
