+            export default class Probe extends View {{
+                init() {{ this.page = WebViewState.new({{asset_root: {}}}); }}
+                close() {{ this.page.release(); }}
+                render() {{ return 'native-handle=' + this.page.__handle; }}
+            }}
+        "#, serde_json::to_string(&directory).unwrap());
+        std::fs::write(directory.join("main.js"), &source).unwrap();
+        let runtime = crate::ShellRuntime::new_isolated().unwrap();
+        cx.update(|cx| runtime.set_global(cx));
+        let window = cx.add_window(|_, _| gpui::Empty);
+        let mut context = VisualTestContext::from_window(*window, cx);
+        let root = context.update(|window, cx| runtime.try_load(&directory, window, cx)).unwrap();
+        let view = context.update(|_, cx| root.read(cx).application().unwrap().view.clone());
+        let drawn = view.clone();
+        context.draw(gpui::Point::default(), gpui::size(gpui::px(400.), gpui::px(300.)),
