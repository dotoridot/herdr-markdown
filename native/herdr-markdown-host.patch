+        let directory = test_directory();
+        std::fs::write(directory.join("index.html"), "local").unwrap();
+        let policy = crate::policy::Policy::new()
+            .with_capabilities(crate::Capabilities::new().read_roots([directory.clone()]));
+        let runtime = crate::ShellRuntime::new_isolated().unwrap();
+        let window = cx.add_window(|_, _| gpui::Empty);
+        let mut context = VisualTestContext::from_window(*window, cx);
