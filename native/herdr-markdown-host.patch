+pub(crate) struct StaticValue<T>(Mutex<T>);
+
+unsafe impl<T> Send for StaticValue<T> {}
+unsafe impl<T> Sync for StaticValue<T> {}
+
+impl<T> std::ops::Deref for StaticValue<T> {
+  type Target = Mutex<T>;
+
+  fn deref(&self) -> &Self::Target {
+    &self.0
+  }
+}
