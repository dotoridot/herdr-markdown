+      self
+        .data_store
+        .httpCookieStore()
+        .setCookie_completionHandler(
+          &wkwebview_cookie,
+          Some(&block2::RcBlock::new(move || {
+            let _ = tx.send(());
+          })),
+        );
+      wait_for_blocking_operation(rx)
+    }
+  }
