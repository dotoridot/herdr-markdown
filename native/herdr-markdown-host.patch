+        );
+        std::fs::remove_dir_all(root).unwrap();
+    }
+    #[test]
+    fn local_webview_granted_bundle_serves_html_script_and_fonts() {
+        let root = test_directory();
+        let assets = root.join("allowed");
+        std::fs::create_dir(&assets).unwrap();
+        for (name, bytes) in [
+            ("index.html", "html"),
+            ("editor.js", "script"),
+            ("font.woff2", "font"),
+        ] {
+            std::fs::write(assets.join(name), bytes).unwrap();
+        }
+        std::fs::write(root.join("private.txt"), "private sibling").unwrap();
+        let policy = crate::policy::Policy::new()
+            .with_capabilities(crate::Capabilities::new().read_roots([assets.clone()]));
+        let state = WebViewState::new(
+            WebViewOptions {
+                asset_root: assets.clone(),
+                entry: "index.html".into(),
+            },
+            &policy,
+        )
+        .unwrap();
+        for (name, bytes) in [
+            ("index.html", "html"),
+            ("editor.js", "script"),
+            ("font.woff2", "font"),
+        ] {
+            assert_eq!(read_asset(&state.assets, name).unwrap(), bytes.as_bytes());
+        }
+        assert!(read_asset(&state.assets, "../private.txt").is_err());
+        #[cfg(target_os = "macos")]
+        {
+            let script = asset_response(&state.assets, "/editor.js");
+            assert_eq!(script.status(), 200);
+            assert_eq!(
+                script.headers()["Content-Type"],
+                "text/javascript; charset=utf-8"
+            );
+            assert_eq!(script.body().as_ref(), b"script");
+            let font = asset_response(&state.assets, "/font.woff2");
+            assert_eq!(font.status(), 200);
+            assert_eq!(font.headers()["Content-Type"], "font/woff2");
+            let sibling = asset_response(&state.assets, "/../private.txt");
+            assert_eq!(sibling.status(), 404);
+            assert_ne!(sibling.body().as_ref(), b"private sibling");
+        }
+        std::fs::remove_dir_all(root).unwrap();
+    }
+    #[cfg(unix)]
+    #[test]
+    fn local_assets_reject_symlinks_outside_the_bundle() {
+        let root = test_directory();
+        let outside = root.join("outside");
+        std::fs::write(&outside, "outside").unwrap();
+        let inner = root.join("inner");
+        std::fs::create_dir(&inner).unwrap();
+        std::os::unix::fs::symlink(&outside, inner.join("link")).unwrap();
+        let assets =
+            cap_std::fs::Dir::open_ambient_dir(&inner, cap_std::ambient_authority()).unwrap();
+        assert!(read_asset(&assets, "link").is_err());
+    }
+}
