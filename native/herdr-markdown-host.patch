+    pub fn apply(&self, mut style: gpui_base::TextViewStyle) -> gpui_base::TextViewStyle {
+        let color = |value: &Option<String>| {
+            value
+                .as_ref()
+                .and_then(|value| crate::value::Bridged::Str(value.clone()).as_color().ok())
+        };
+        if let Some(value) = color(&self.foreground) {
+            let inline = gpui::HighlightStyle {
+                color: Some(value),
+                ..style.inline_code()
+            };
+            style = style.with_foreground(value).with_inline_code(inline);
+        }
+        if let Some(value) = color(&self.muted_foreground) {
+            style = style.with_muted_foreground(value);
+        }
+        if let Some(value) = color(&self.link) {
+            style = style.with_link(value);
+        }
+        if let Some(value) = color(&self.selection) {
+            style = style.with_selection(value);
+        }
+        if let Some(value) = color(&self.code_background) {
+            let inline = gpui::HighlightStyle {
+                background_color: Some(value),
+                ..style.inline_code()
+            };
+            style = style.with_code_background(value).with_inline_code(inline);
+        }
+        if let Some(value) = color(&self.border) {
+            style = style.with_border(value);
+        }
